#!/bin/sh
# Claude Code hook: record this pane's Claude state in the tmux pane option
# @claude, so tmux-project can show which sessions are waiting on you.
# A pane where Claude was never prompted stays untagged.
#
# Usage: claude-tmux-state working|waiting|blocked|clear

cat >/dev/null # drain the hook's JSON payload
[ -n "$TMUX_PANE" ] || exit 0

case "$1" in
    clear) tmux set-option -pu -t "$TMUX_PANE" @claude ;;
    *) tmux set-option -p -t "$TMUX_PANE" @claude "$1" ;;
esac 2>/dev/null
exit 0
