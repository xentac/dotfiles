export EDITOR=nvim

# Emacs-style line editing (EDITOR=nvim otherwise makes zsh default to vi mode).
bindkey -e

# Word navigation (zsh ignores ~/.inputrc, so bind these here).
# Find a key's sequence with ctrl-v then the key.
bindkey '^[[1;3C' forward-word   # alt-right
bindkey '^[[1;3D' backward-word  # alt-left
bindkey '^[^[[C' forward-word    # alt-right (esc + arrow variant)
bindkey '^[^[[D' backward-word   # alt-left (esc + arrow variant)
bindkey '^[[1;5C' forward-word   # ctrl-right
bindkey '^[[1;5D' backward-word  # ctrl-left
bindkey '^[k' backward-kill-word # alt-k (chromebook alt-backspace stand-in)

# Home/End/Delete (variants for different terminals)
bindkey '^[[H' beginning-of-line  # home
bindkey '^[[1~' beginning-of-line # home (vt variant)
bindkey '^[OH' beginning-of-line  # home (application mode)
bindkey '^[[F' end-of-line        # end
bindkey '^[[4~' end-of-line       # end (vt variant)
bindkey '^[OF' end-of-line        # end (application mode)
bindkey '^[[3~' delete-char       # delete

# Edit the current command line in $EDITOR (bound by default in bash, not zsh).
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

#alias vim=nvim
#alias vimdiff="nvim -d"

# All of my remote terminals support truecolor
[[ -z $COLORTERM ]] && export COLORTERM=truecolor
